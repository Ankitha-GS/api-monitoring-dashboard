      "type": "timeseries",
      "title": "Service Health Status (1 = healthy)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
